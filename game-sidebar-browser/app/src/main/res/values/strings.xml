    <!-- Permission -->
    <string name="permission_title">Allow the floating sidebar</string>
    <string name="permission_body">This permission allows Game SideBar to appear over games and other applications. It is the only way Android lets an app draw a panel on top of another app.\n\nNothing is injected into games, no game data is read, and no automation happens: the sidebar is a normal floating window that you can hide at any time.</string>
    <string name="permission_enable">Enable Floating Sidebar</string>
    <string name="permission_skip">Continue without overlay</string>
    <string name="permission_granted">Overlay permission granted</string>
    <string name="permission_denied_body">Without the overlay permission the sidebar cannot float, but the in-app browser, bookmarks, history and tools all keep working.</string>
    <string name="permission_notification_title">Show notifications</string>
    <string name="permission_notification_body">The sidebar runs as a foreground service, so Android shows a persistent notification with Open, Hide and Stop actions.</string>

