<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="gamesidebar.db" />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="webview" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="gamesidebar.db" />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="webview" />
    </device-transfer>
</data-extraction-rules>
