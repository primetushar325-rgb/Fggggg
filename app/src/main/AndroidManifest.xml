<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Recording: requested at runtime, only when the user opens the recorder. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notification permission (Android 13+): for the Gaming Mode / playback notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Floating bubble overlay: officially supported SYSTEM_ALERT_WINDOW mechanism. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground services: floating soundboard while Gaming Mode is on, and background
         music playback with a dismissible notification. No other services run. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Deliberately NOT requested: storage (SAF is used instead), contacts, SMS, phone,
         location, camera, accessibility services, root. The app never touches other apps,
         game processes, game files or game memory. -->

    <application
        android:name=".GameSoundProApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GameSoundPro"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating gaming overlay. Runs only while the user has Gaming Mode enabled and
             only after explicitly granting the "Display over other apps" permission. -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating soundboard bubble shown above other apps while the user has Gaming Mode enabled" />
        </service>

        <!-- Background music playback notification. Started only while music is playing. -->
        <service
            android:name=".service.PlaybackNotificationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
