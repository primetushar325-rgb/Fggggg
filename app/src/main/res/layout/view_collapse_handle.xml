<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed handle - small, unobtrusive, within bounds -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collapseHandleRoot"
    android:layout_width="@dimen/handle_size"
    android:layout_height="@dimen/handle_size"
    android:background="@drawable/bg_handle"
    android:elevation="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="◀"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:contentDescription="@string/handle_content_desc" />
</FrameLayout>
