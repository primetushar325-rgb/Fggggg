<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the entire UI; this XML theme only needs to give a dark, chrome-less
         window so cold start never flashes white. In-app theme switching is handled by
         GameSoundProTheme. -->
    <style name="Theme.GameSoundPro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
